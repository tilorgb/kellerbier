{
  "name": "kellerbier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Bavarian cellar-crawling roguelike bullet hell.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:atlas": "node tools/art/build-atlas.mjs",
    "art:diffusion-postprocess": "node tools/art/diffusion-postprocess-cli.mjs",
    "art:alois": "node tools/art/authoring/build-alois.mjs",
    "art:bosses": "node tools/art/authoring/build-bosses.mjs",
    "art:blocks": "node tools/art/authoring/build-blocks.mjs",
    "art:floor1": "node tools/art/authoring/build-floor1-roster.mjs",
    "art:minibosses": "node tools/art/authoring/build-floor1-minibosses.mjs",
    "art:floor2": "node tools/art/authoring/build-floor2-roster.mjs",
    "art:minibosses2": "node tools/art/authoring/build-floor2-minibosses.mjs",
    "art:shopkeeper": "node tools/art/authoring/build-shopkeeper.mjs",
    "art:items": "node tools/art/authoring/build-items.mjs",
    "art:title": "node tools/art/authoring/build-title-key-art.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "bench": "vitest run --config vitest.bench.config.ts",
    "fuzz": "vitest run --config vitest.fuzz.config.ts",
    "playtest": "vitest run --config vitest.playtest.config.ts",
    "perf:crossings": "node tools/perf/room-crossings.mjs walk 12 --gate"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "playwright-core": "^1.58.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
