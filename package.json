{
  "name": "kellerbier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Bavarian cellar-crawling roguelike bullet hell.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:atlas": "node tools/art/build-atlas.mjs",
    "art:alois": "node tools/art/authoring/build-alois.mjs",
    "art:bosses": "node tools/art/authoring/build-bosses.mjs",
    "art:blocks": "node tools/art/authoring/build-blocks.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "bench": "vitest run --config vitest.bench.config.ts",
    "fuzz": "vitest run --config vitest.fuzz.config.ts"
  },
  "dependencies": {
    "pixi.js": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
