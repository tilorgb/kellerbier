# dependencies
node_modules/
.pnp
.pnp.js

# build output. Anchored with a leading slash: an unanchored `build/` matches a
# directory of that name at any depth, which quietly swallowed `tests/build/`
# — the release build's own test — the moment one existed.
/dist/
/dist-ssr/
/build/
*.local

# test & coverage
coverage/
.vitest/

# benchmark artifacts — the run is per-machine, the history is the record
bench/results.json

# fuzz harness artifacts — same reasoning as bench/results.json
fuzz/results.json

# balance simulator (playtest bot) artifacts — same reasoning as bench/results.json
playtest/results.json

# generated assets
assets/atlases/*.png
assets/atlases/*.json

# editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Claude Code CLI's own per-issue worktree checkouts (CLAUDE.md's "one git
# worktree per issue/branch") — a full nested checkout, never repo content.
.claude/worktrees/

# os
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-error.log*
dist-treeshake-test

# tools/perf/room-crossings.mjs writes its per-run report and CPU profile next to where it ran
room-crossings-*.json
room-crossings.cpuprofile
tools/art/authoring/preview/

# `npm run build:release` output — the one-file build handed to a player.
# Build output, like /dist/: 17 MB of base64 rebuilt from source in a second.
# Anchored, so it does not also hide `tools/release/`, which builds it.
/release/
